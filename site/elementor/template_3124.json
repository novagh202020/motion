[{"id":"10e58caa","elType":"widget","widgetType":"html","settings":{"html":"<style>\n/* CarDiag product page skin (template 3124 + product 2560). Content lives in normal Elementor widgets;\n   this block only styles them, adds the sticky buy bar and the added-to-cart popup. */\n.cdp,.cdp-sec,.cdp-bar,.cdp-sheet{--b:#2196F3;--d:#1565C0;--s:#E3EFFC;--n:#10203C;--sl:#6E7D96;--l:#DEE6F2;--bg:#F4F8FD;--g:#22A050;--gt:#DEF6E6;--r:#DC3232;--rt:#FFECEC;--ink:#4B3005;font-family:Vazirmatn,inherit}\n.cdp,.cdp-sec{color:var(--n);direction:rtl}\n.cdp *,.cdp-sec *{box-sizing:border-box}\n.elementor-3124 .cdp.e-con,.elementor-2560 .cdp-sec.e-con{--padding-top:0px;--padding-bottom:0px;--padding-left:0px;--padding-right:0px}\n.cdp-wrap{max-width:none;margin:0!important;width:100%}\n.cdp-crumbs .woocommerce-breadcrumb{font-size:13px;color:var(--sl);margin:4px 0 10px!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.cdp-crumbs a{color:var(--sl)!important}\n/* hero */\n.cdp-gal img{box-sizing:border-box;max-width:100%;width:100%;aspect-ratio:1/1;object-fit:contain;border-radius:24px;padding:28px;background:radial-gradient(120% 90% at 50% 30%,#fff 0%,#EAF3FD 60%,#DCEBFB 100%)}\n.cdp-gal{position:relative}\n.cdp-badge{position:absolute;top:14px;right:14px;z-index:2;background:var(--r);color:#fff;font-weight:800;font-size:14px;padding:4px 12px;border-radius:12px;display:none}\n.cdp-title .elementor-heading-title{font-size:21px!important;font-weight:900!important;line-height:1.55!important;color:var(--n)!important;margin:0}\n.cdp-model p{margin:0;font-size:14px;color:var(--sl);font-weight:500}\n.cdp-stock p{margin:0}\n.cdp-stock .in,.cdp-stock .out{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;padding:3px 12px;border-radius:12px}\n.cdp-stock .in{color:var(--g);background:var(--gt)}.cdp-stock .out{color:var(--r);background:var(--rt);display:none}\n.instock .cdp-stock .out,.outofstock .cdp-stock .in{display:none}.outofstock .cdp-stock .out{display:inline-flex}\n.cdp-buybox{background:#fff;border:1px solid var(--l)!important;border-radius:20px;padding:16px!important}\n.cdp-prices{display:flex;align-items:flex-end;justify-content:space-between;gap:12px}\n.cdp-old .elementor-heading-title{font-size:14px!important;color:#98A3B8!important;font-weight:500!important;text-decoration:line-through}\n.cdp-now .elementor-heading-title{font-size:26px!important;font-weight:900!important;color:var(--n)!important;line-height:1.3!important}\n.cdp-now .woocommerce-Price-currencySymbol{font-size:14px;color:var(--sl);font-weight:700}\n.cdp-save{font-size:13px;font-weight:700;color:var(--r);background:var(--rt);padding:3px 10px;border-radius:10px;white-space:nowrap;display:none}\n.cdp-gift .elementor-icon-box-wrapper{display:flex!important;align-items:center;gap:12px;text-align:right!important;padding:12px 14px;border-radius:16px;background:linear-gradient(90deg,#F6CD5C 0%,#FFEA9C 55%,#F2D27A 100%)}\n.cdp-gift .elementor-icon-box-icon{margin:0!important}.cdp-gift .elementor-icon{font-size:28px!important;color:var(--ink)!important;fill:var(--ink)}\n.cdp-gift .elementor-icon-box-title{margin:0!important;font-size:15px!important;font-weight:900!important;color:var(--ink)!important;line-height:1.5}\n.cdp-gift .elementor-icon-box-description{margin:0!important;font-size:12.5px!important;color:var(--ink)!important;line-height:1.6}\n.cdp-cart{display:flex;gap:10px;margin:0}\n.cdp-qty{display:flex;align-items:center;border:1px solid var(--l);border-radius:14px;height:52px;overflow:hidden;flex:none}\n.cdp-qty button{width:38px;height:100%;border:0;background:var(--bg);font:inherit;font-size:20px;color:var(--n);padding:0}\n.cdp-qty input{width:40px;height:100%;border:0!important;text-align:center;font:inherit;font-weight:800;font-size:16px;color:var(--n);background:#fff;padding:0!important;-moz-appearance:textfield}\n.cdp-qty input::-webkit-inner-spin-button{display:none}\n.cdp-btn{flex:1;height:52px;border:0;border-radius:14px;background:var(--b);color:#fff!important;font:inherit;font-weight:800;font-size:16px;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 8px 18px rgba(33,150,243,.28);cursor:pointer;text-decoration:none!important;padding:0 16px}\n.cdp-btn:hover{background:var(--d)}.cdp-btn[disabled]{opacity:.6;cursor:wait}\n.cdp-btn.ghost{background:#fff;color:var(--d)!important;border:1.5px solid var(--b);box-shadow:none}\n.outofstock .cdp-cart .cdp-btn{background:#98A3B8;pointer-events:none;box-shadow:none}\n.cdp-trust .elementor-icon-list-items{display:grid!important;grid-template-columns:1fr 1fr;gap:8px;margin:0!important;padding:0!important}\n.cdp-trust .elementor-icon-list-item{margin:0!important;padding:10px!important;background:var(--bg);border-radius:14px;align-items:center!important}\n.cdp-trust .elementor-icon-list-item::after{display:none!important}\n.cdp-trust .elementor-icon-list-text{font-size:12.5px!important;font-weight:700!important;color:var(--n)!important;line-height:1.5!important;padding-right:8px!important}\n.cdp-trust .elementor-icon-list-icon i,.cdp-trust .elementor-icon-list-icon svg{color:var(--b)!important;fill:var(--b)!important;font-size:18px!important}\n.cdp-fit a{text-decoration:none}\n.cdp-fit .elementor-icon-box-wrapper{display:flex!important;align-items:center;gap:12px;text-align:right!important;padding:14px;border-radius:20px;background:var(--n)}\n.cdp-fit .elementor-icon-box-icon{margin:0!important}.cdp-fit .elementor-icon{font-size:26px!important;color:#78CDFF!important}\n.cdp-fit .elementor-icon-box-title,.cdp-fit .elementor-icon-box-title a{margin:0!important;font-size:15px!important;font-weight:800!important;color:#fff!important}\n.cdp-fit .elementor-icon-box-description{margin:0!important;font-size:12.5px!important;color:#C9D6EA!important}\n.cdp-lead p{font-size:14.5px;line-height:1.95;color:#33415C;margin:0}\n/* section chips */\n.cdp-snav{position:sticky;top:0;z-index:20;background:rgba(251,252,255,.95);backdrop-filter:blur(8px);border-bottom:1px solid var(--l);margin-top:20px!important}\n.cdp-snav .elementor-icon-list-items{display:flex!important;flex-wrap:nowrap!important;overflow-x:auto;gap:6px;padding:10px 0!important;margin:0!important;scrollbar-width:none}\n.cdp-snav .elementor-icon-list-items::-webkit-scrollbar{display:none}\n.cdp-snav .elementor-icon-list-item{margin:0!important;padding:0!important}.cdp-snav .elementor-icon-list-item::after{display:none!important}\n.cdp-snav .elementor-icon-list-icon{display:none!important}\n.cdp-snav a{display:block!important;white-space:nowrap;font-size:13.5px;font-weight:700;color:var(--sl)!important;padding:6px 14px;border-radius:12px;background:#fff;border:1px solid var(--l)}\n.cdp-snav a.on{color:var(--d)!important;border-color:var(--b);background:var(--s)}\n.cdp-snav .elementor-icon-list-text{color:inherit!important;padding:0!important}\n/* content sections (product 2560) */\n.cdp-body{max-width:none;margin:0!important}\n.cdp-sec .elementor-widget-text-editor p{max-width:75ch}\n.cdp-sec{padding:28px 0 4px!important;scroll-margin-top:64px}\n.cdp-sec h2.elementor-heading-title{font-size:19px!important;font-weight:900!important;line-height:1.5!important;color:var(--n)!important;margin:0 0 6px}\n.cdp-sec h2 span{color:var(--b)}\n.cdp-sec .elementor-widget-text-editor{font-size:14px;line-height:1.95;color:#33415C}\n.cdp-sec .elementor-widget-text-editor p:last-child{margin-bottom:0}\n.cdp-show{align-items:center!important}\n.cdp-show .elementor-widget-image img{width:120px;border-radius:20px;box-shadow:0 14px 30px rgba(20,40,80,.16)}\n.cdp-feat .elementor-icon-box-wrapper,.cdp-tiles .elementor-icon-box-wrapper{display:flex!important;gap:10px;text-align:right!important;align-items:flex-start}\n.cdp-feat .elementor-icon-box-icon,.cdp-tiles .elementor-icon-box-icon{margin:0!important}\n.cdp-feat .elementor-icon,.cdp-tiles .elementor-icon{width:40px;height:40px;border-radius:12px;background:var(--s);color:var(--b)!important;font-size:18px!important;display:flex!important;align-items:center;justify-content:center;padding:0!important}\n.cdp-feat .elementor-icon-box-title,.cdp-tiles .elementor-icon-box-title{margin:0!important;font-size:14.5px!important;font-weight:800!important;color:var(--n)!important;line-height:1.6}\n.cdp-feat .elementor-icon-box-description,.cdp-tiles .elementor-icon-box-description{margin:0!important;font-size:13px!important;color:var(--sl)!important;line-height:1.7}\n.cdp-tiles{display:grid!important;grid-template-columns:1fr 1fr;gap:10px}\n.cdp-tiles>.elementor-widget{background:#fff;border:1px solid var(--l);border-radius:18px;padding:14px;margin:0!important;width:auto!important}\n.cdp-tiles .elementor-icon-box-wrapper{flex-direction:column}\n.cdp-video{border-radius:20px;overflow:hidden;background:#EAF3FD}\nol.cdp-steps{list-style:none;counter-reset:s;margin:0;padding:0}\nol.cdp-steps li{position:relative;padding:0 52px 20px 0;margin:0}\nol.cdp-steps li::before{counter-increment:s;content:counter(s,persian);position:absolute;right:0;top:0;width:38px;height:38px;border-radius:50%;background:var(--b);color:#fff;font-weight:900;display:flex;align-items:center;justify-content:center;font-size:16px}\nol.cdp-steps li::after{content:\"\";position:absolute;right:18px;top:42px;bottom:4px;width:2px;background:var(--l)}\nol.cdp-steps li:last-child::after{display:none}\nol.cdp-steps b{display:block;font-size:15px;color:var(--n);line-height:2.4}\ntable.cdp-vs,table.cdp-spec{width:100%;border-collapse:separate;border-spacing:0 8px;margin:0;font-size:12.5px;table-layout:fixed}\ntable.cdp-vs th{font-size:12.5px;font-weight:800;color:var(--sl);text-align:center;padding:0 4px;border:0;background:none}\ntable.cdp-vs th:last-child{color:var(--d)}\ntable.cdp-vs td{background:#fff;border:1px solid var(--l);border-width:1px 0;padding:10px 6px;text-align:center;color:var(--sl);line-height:1.5;vertical-align:middle}\ntable.cdp-vs td:first-child{border-right-width:1px;border-radius:0 16px 16px 0;text-align:right;font-weight:800;color:var(--n);padding-right:12px}\ntable.cdp-vs td:last-child{border-left-width:1px;border-radius:16px 0 0 16px;padding-left:10px}\ntable.cdp-vs td:last-child span{display:inline-block;color:var(--g);font-weight:800;background:var(--gt);border-radius:10px;padding:4px 8px}\ntable.cdp-spec{border-spacing:0;background:#fff;border:1px solid var(--l);border-radius:20px;overflow:hidden;font-size:13.5px}\ntable.cdp-spec td{padding:12px 16px;border:0;border-bottom:1px solid #EEF2F8;color:var(--n);font-weight:700;text-align:left;vertical-align:top}\ntable.cdp-spec tr:last-child td{border-bottom:0}\ntable.cdp-spec td:first-child{color:var(--sl);font-weight:500;text-align:right;width:38%}\n.cdp-who .elementor-icon-list-items{background:#fff;border:1px solid var(--l);border-radius:20px;padding:10px 16px!important}\n.cdp-who .elementor-icon-list-item{padding:8px 0!important;align-items:flex-start!important}\n.cdp-who .elementor-icon-list-text{font-size:14px!important;color:#33415C!important;padding-right:10px!important;line-height:1.8}\n.cdp-who .elementor-icon-list-icon i{color:var(--g)!important;margin-top:6px}\n.cdp-note p{font-size:13px;color:#33415C;background:var(--s);border-radius:16px;padding:12px 14px;margin:0}\n.cdp-acc .elementor-accordion-item{background:#fff;border:1px solid var(--l)!important;border-radius:16px;margin-bottom:8px;overflow:hidden}\n.cdp-acc .elementor-tab-title{padding:14px 16px!important;border:0!important;font-weight:800!important;font-size:14.5px!important;color:var(--n)!important;line-height:1.6}\n.cdp-acc .elementor-tab-title a{color:var(--n)!important}\n.cdp-acc .elementor-tab-title.elementor-active a{color:var(--d)!important}\n.cdp-acc .elementor-accordion-icon{color:var(--sl)!important}\n.cdp-acc .elementor-tab-content{padding:0 16px 14px!important;border:0!important;font-size:13.5px;color:#33415C;line-height:1.9}\n.cdp-acc .elementor-tab-content ul{list-style:none;margin:0;padding:0}\n.cdp-acc .elementor-tab-content li{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-top:1px dashed var(--l)}\n.cdp-acc .elementor-tab-content li:first-child{border-top:0}\n.cdp-acc .elementor-tab-content li span{font-size:12px;color:var(--sl);text-align:left}\n.cdp-final{margin:28px 0 8px!important;border-radius:24px;padding:22px 18px!important;background:linear-gradient(135deg,#1565C0,#2196F3);text-align:center}\n.cdp-final .elementor-heading-title{color:#fff!important;font-size:20px!important;font-weight:900!important}\n.cdp-final p{color:#DCEBFB;font-size:14px;margin:0}\n.cdp-final .elementor-button{width:100%;background:#fff!important;color:var(--d)!important;border-radius:14px!important;font-weight:800!important;font-size:16px!important;padding:15px!important}\n/* nothing inside the product page may be wider than the phone screen (a wider element makes mobile Chrome zoom the whole page out) */\n.elementor-3124,.elementor-2560{max-width:100%;overflow-x:clip}\n.elementor-3124 .e-con,.elementor-3124 .elementor-widget,.elementor-3124 .elementor-widget-container,.elementor-2560 .e-con,.elementor-2560 .elementor-widget,.elementor-2560 .elementor-widget-container{min-width:0!important;max-width:100%}\n.elementor-3124 img,.elementor-3124 iframe,.elementor-3124 video,.elementor-3124 table,.elementor-2560 img,.elementor-2560 iframe,.elementor-2560 video,.elementor-2560 table{max-width:100%!important;min-width:0!important}\n.elementor-3124 table,.elementor-2560 table{width:100%!important;table-layout:fixed!important}\n.cdp-sec td,.cdp-sec th,.cdp-acc .elementor-tab-title{overflow-wrap:anywhere}\n.cdp-debug{position:fixed!important;left:8px;right:8px;top:8px;z-index:2147483647;background:#10203C;color:#fff;font:600 12px/1.6 monospace;direction:ltr;text-align:left;padding:10px 12px;border-radius:12px;white-space:pre-wrap;max-height:60vh;overflow:auto}\n/* sticky buy bar + popup: unique class names so theme rules for generic classes (.box, .item, .close…) can't touch them */\n.cdp-bar{position:fixed!important;left:0;right:0;bottom:0;top:auto;z-index:2147483000;background:#fff;border-top:1px solid var(--l);box-shadow:0 -8px 24px rgba(20,40,80,.08);padding:10px 16px calc(10px + env(safe-area-inset-bottom));display:flex;align-items:center;gap:12px;direction:rtl;margin:0;transform:none}\n.cdp-bar[hidden]{display:none!important}\n.cdp-bar-p{line-height:1.3;color:var(--n)}.cdp-bar-p del{display:block;font-size:12px;color:#98A3B8}.cdp-bar-p b{font-size:17px;font-weight:900}\n.single-product{padding-bottom:84px}\n.cdp-sheet{position:fixed!important;top:0;right:0;bottom:0;left:0;z-index:2147483600;display:flex;align-items:flex-end;justify-content:center;visibility:hidden;direction:rtl;margin:0;padding:0;transform:none;float:none}\n.cdp-sheet.open{visibility:visible}\n.cdp-sh-dim{position:absolute;top:0;right:0;bottom:0;left:0;background:rgba(16,32,60,.45);opacity:0;transition:opacity .2s}\n.cdp-sheet.open .cdp-sh-dim{opacity:1}\n.cdp-sh-box{position:relative;float:none;top:auto;left:auto;margin:0;width:100%;max-width:480px;max-height:calc(100vh - 24px);max-height:calc(100dvh - 24px);overflow-y:auto;box-sizing:border-box;background:#fff;color:var(--n);border-radius:24px 24px 0 0;padding:10px 18px calc(18px + env(safe-area-inset-bottom));transform:translateY(100%);transition:transform .25s cubic-bezier(.2,.8,.2,1);display:grid;gap:14px;box-shadow:0 -10px 40px rgba(20,40,80,.18);text-align:right}\n.cdp-sheet.open .cdp-sh-box{transform:none}\n.cdp-sh-grab{width:44px;height:5px;border-radius:3px;background:var(--l);margin:0 auto 2px}\n.cdp-sh-ok{display:flex;align-items:center;gap:10px;font-weight:900;font-size:17px;color:var(--g);padding-left:44px}\n.cdp-sh-ok i{width:30px;height:30px;border-radius:50%;background:var(--gt);display:flex;align-items:center;justify-content:center;font-style:normal;flex:none}\n.cdp-sh-item{display:flex;align-items:center;gap:12px;background:var(--bg);border-radius:16px;padding:10px;margin:0}\n.cdp-sh-item img{width:64px;height:64px;object-fit:contain;background:#fff;border-radius:12px;padding:6px;flex:none}\n.cdp-sh-item b{display:block;font-size:14px;font-weight:800;line-height:1.6}.cdp-sh-item span{font-size:13px;color:var(--sl)}\n.cdp-sh-gift{font-size:13px;font-weight:700;color:var(--ink);background:#FFF4D1;border-radius:12px;padding:8px 12px}\n.cdp-sh-sum{display:flex;justify-content:space-between;align-items:center;font-size:14px;color:var(--sl)}.cdp-sh-sum b{font-size:18px;font-weight:900;color:var(--n)}\n.cdp-sh-acts{display:grid;gap:8px}.cdp-sh-acts .cdp-btn{flex:none;width:100%}\n.cdp-sh-close{position:absolute;top:12px;left:12px;right:auto;width:36px;height:36px;border:0;border-radius:50%;background:var(--bg);color:var(--sl);font-size:20px;line-height:1;padding:0;margin:0;opacity:1;float:none}\n.cdp-btn:focus-visible,.cdp-sh-close:focus-visible,.cdp-qty button:focus-visible{outline:3px solid #78CDFF;outline-offset:2px}\n@media (min-width:768px){\n .cdp-title .elementor-heading-title{font-size:28px!important}\n .cdp-sec h2.elementor-heading-title{font-size:24px!important}\n .cdp-tiles{grid-template-columns:repeat(4,1fr)}\n .cdp-trust .elementor-icon-list-items{grid-template-columns:repeat(4,1fr)}\n .cdp-show .elementor-widget-image img{width:200px}\n table.cdp-vs,table.cdp-vs th{font-size:14px}\n .cdp-sheet{align-items:center}.cdp-sh-box{border-radius:24px;padding:22px 24px;transform:translateY(24px) scale(.96);opacity:0;transition:transform .2s,opacity .2s}\n .cdp-sheet.open .cdp-sh-box{opacity:1;transform:none}.cdp-sh-grab{display:none}\n}\n@media (min-width:1025px){\n .cdp-trust .elementor-icon-list-items{grid-template-columns:1fr 1fr}\n .cdp-gal{position:sticky!important;top:20px;align-self:flex-start}\n .cdp-bar{display:none}.single-product{padding-bottom:0}\n}\n@media (prefers-reduced-motion:reduce){.cdp-sh-box,.cdp-sh-dim{transition:none}}\n</style>\n<div class=\"cdp-bar\" id=\"cdp-bar\" hidden><div class=\"cdp-bar-p\"><del id=\"cdp-bar-old\"></del><b id=\"cdp-bar-now\"></b></div><button type=\"button\" class=\"cdp-btn\" data-cdp-add>افزودن به سبد</button></div>\n<div class=\"cdp-sheet\" id=\"cdp-sheet\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"cdp-sheet-t\" aria-hidden=\"true\">\n <div class=\"cdp-sh-dim\" data-close></div>\n <div class=\"cdp-sh-box\">\n  <div class=\"cdp-sh-grab\"></div>\n  <button type=\"button\" class=\"cdp-sh-close\" data-close aria-label=\"بستن\">×</button>\n  <div class=\"cdp-sh-ok\" id=\"cdp-sheet-t\"><i>✓</i>به سبد خرید اضافه شد</div>\n  <div class=\"cdp-sh-item\"><img id=\"cdp-sheet-img\" alt=\"\"><div><b id=\"cdp-sheet-name\"></b><span id=\"cdp-sheet-q\"></span></div></div>\n  <div class=\"cdp-sh-gift\">🎁 اشتراک طلایی اپ هم همراهش فعال می‌شود</div>\n  <div class=\"cdp-sh-sum\"><span>مبلغ قابل پرداخت</span><b id=\"cdp-sheet-sum\"></b></div>\n  <div class=\"cdp-sh-acts\">\n   <a class=\"cdp-btn\" href=\"/checkout/\" id=\"cdp-checkout\">تسویه حساب و ادامه خرید</a>\n   <button type=\"button\" class=\"cdp-btn ghost\" data-close>ادامه‌ی گشت‌وگذار</button>\n  </div>\n </div>\n</div>\n<script>\n(function(){\n function ready(f){document.readyState!=='loading'?f():document.addEventListener('DOMContentLoaded',f)}\n ready(function(){\n  // #cdpdebug in the URL: list elements wider than the screen (for diagnosing mobile zoom-out)\n  if(location.hash==='#cdpdebug'){setTimeout(function(){var W=document.documentElement.clientWidth,rows=['viewport '+W+' / page '+document.documentElement.scrollWidth+' / screen '+screen.width];\n   var bad=[];[].forEach.call(document.querySelectorAll('body *'),function(e){var r=e.getBoundingClientRect();if(!r.width||e.closest('#cdp-sheet,#cdp-bar,.cdp-debug')||getComputedStyle(e).position==='fixed')return;if(r.left<-1||r.right>W+1)bad.push({e:e,r:r})});\n   bad.filter(function(b){return !bad.some(function(o){return o.e!==b.e&&b.e.contains(o.e)})}).sort(function(a,b){return b.r.right-a.r.right}).forEach(function(b){var e=b.e;rows.push(e.tagName.toLowerCase()+'.'+String(e.className).trim().split(/\\s+/).slice(0,4).join('.')+(e.id?'#'+e.id:'')+'  L'+Math.round(b.r.left)+' R'+Math.round(b.r.right))});\n   var d=document.createElement('div');d.className='cdp-debug';d.textContent=rows.slice(0,12).join('\\n');document.body.appendChild(d)},1500)}\n  var form=document.querySelector('.cdp-cart'); if(!form) return;\n  ['cdp-bar','cdp-sheet'].forEach(function(id){document.body.appendChild(document.getElementById(id))});\n  var w=document.querySelector('.elementor-location-single[class*=\"post-\"]'), m=document.body.className.match(/postid-(\\d+)/)||(w&&w.className.match(/\\bpost-(\\d+)\\b/)), pid=m?m[1]:'';\n  form.querySelector('[name=add-to-cart]').value=pid;\n  var qty=form.querySelector('input[name=quantity]');\n  var digits=function(t){return (t||'').replace(/[۰-۹]/g,function(d){return '۰۱۲۳۴۵۶۷۸۹'.indexOf(d)}).replace(/[٠-٩]/g,function(d){return '٠١٢٣٤٥٦٧٨٩'.indexOf(d)})};\n  var num=function(t){return parseInt(digits(t).replace(/[^\\d]/g,''),10)||0};\n  var fmt=function(n){return String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g,'.')+' تومان'};\n  var nowEl=document.querySelector('.cdp-now .elementor-heading-title'), oldEl=document.querySelector('.cdp-old .elementor-heading-title');\n  var now=num(nowEl&&nowEl.textContent), old=num(oldEl&&oldEl.textContent);\n  if(!old||old<=now){var o=document.querySelector('.cdp-old');if(o)o.style.display='none'}\n  else{var pct=Math.round((old-now)/old*100);\n   document.querySelectorAll('.cdp-save').forEach(function(e){e.textContent=pct+'٪ تخفیف';e.style.display='inline-block'});\n   var bg=document.querySelector('.cdp-badge'); if(bg){bg.textContent=pct+'٪ تخفیف';bg.style.display='block'}\n   document.getElementById('cdp-bar-old').textContent=fmt(old)}\n  document.getElementById('cdp-bar-now').textContent=fmt(now);\n  var bar=document.getElementById('cdp-bar'); bar.hidden=false;\n  form.querySelectorAll('[data-q]').forEach(function(b){b.addEventListener('click',function(){\n   var v=Math.min(99,Math.max(1,(